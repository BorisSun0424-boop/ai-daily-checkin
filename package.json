{
  "name": "zaoba",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "早八 · 每天自动完成 AI 工具签到（WorkBuddy / 豆包工作 / 智谱），支持 macOS 与 Windows，带本地可视化控制台",
  "scripts": {
    "login": "node src/index.js login",
    "probe": "node src/index.js probe",
    "checkin": "node src/index.js run --skip-if-done",
    "dry-run": "node src/index.js run --dry-run",
    "list": "node src/index.js list",
    "report": "node src/index.js report",
    "postinstall": "node -e \"console.log('\\n下一步: npx playwright install chromium\\n')\"",
    "clients": "node src/index.js clients",
    "web": "node src/index.js web",
    "bootstrap": "bash scripts/bootstrap.sh",
    "check": "bash scripts/bootstrap.sh --check",
    "schedule": "node src/index.js schedule",
    "service:install": "node src/index.js install-service",
    "service:uninstall": "node src/index.js uninstall-service",
    "open": "node src/open-console.js",
    "login:minimax": "node src/minimax-login.js",
    "setup": "node src/setup.js"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "engines": {
    "node": ">=18"
  }
}
